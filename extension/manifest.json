{
  "manifest_version": 3,
  "name": "tidytabs helper",
  "version": "0.3.1",
  "description": "Lets the tidytabs command line tool list and move tabs without a reload.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "tidytabs helper: run tidytabs in a terminal"
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
